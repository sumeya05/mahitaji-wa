{
  "expo": {
    "name": "Mahitaji Fleet",
    "slug": "mahitaji-fleet",
    "scheme": "mahitajifleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.mahitaji.fleet"
    },
    "android": {
      "package": "ke.co.mahitaji.fleet",
      "adaptiveIcon": {
        "backgroundColor": "#F6FAFD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mahitaji Fleet uses your location to record where a customer's shop is."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6FAFD",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
